# Copy to deploy/.env on the server and fill in. Never commit the real file.

# Your domain without https:// and without www (www redirects to it).
DOMAIN=example.com
# Email for Let's Encrypt certificate notices.
ACME_EMAIL=you@example.com

# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=change-me
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

SITE_NAME=Malta guide
# Hard-to-guess admin paths (keep the trailing slash).
ADMIN_URL=manage-admin/
CMS_URL=cms/

# Outgoing email (booking confirmations). Leave as is to only log emails.
# Example: EMAIL_URL=smtp+tls://user:password@smtp.eu.mailgun.org:587
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=bookings@example.com
# Where new contact messages are sent.
GUIDE_NOTIFY_EMAIL=

LOG_LEVEL=INFO
