# Staging server: same as Caddyfile, but the whole site is behind a password and
# search engines are told not to index it. Selected with CADDYFILE=Caddyfile.staging
# in deploy/.env; BASIC_AUTH_USER and BASIC_AUTH_HASH come from there too.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	handle_path /static/* {
		root * /srv/static
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=604800"
		file_server
	}

	handle {
		reverse_proxy web:8000
	}
}
